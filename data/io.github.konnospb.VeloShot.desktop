[Desktop Entry]
Name=VeloShot
GenericName=Screenshot Tool
Comment=Schnelles Wayland-Screenshot-Tool mit Verlaufs-Karussell und Editor
Comment[en]=Fast Wayland screenshot tool with carousel history and annotation editor
Exec=veloshot
Icon=io.github.konnospb.VeloShot
Terminal=false
Type=Application
Categories=Utility;Graphics;GTK;
Keywords=screenshot;capture;wayland;gnome;snap;annotate;carousel;
StartupNotify=true
DBusActivatable=false
Actions=Capture;History;Window;Settings;

[Desktop Action Capture]
Name=Bereich aufnehmen
Name[en]=Capture Region
Exec=veloshot capture

[Desktop Action History]
Name=Verlauf-Karussell öffnen
Name[en]=Open Carousel History
Exec=veloshot history

[Desktop Action Window]
Name=Hauptfenster öffnen
Name[en]=Open Main Window
Exec=veloshot window

[Desktop Action Settings]
Name=Einstellungen
Name[en]=Settings
Exec=veloshot settings
